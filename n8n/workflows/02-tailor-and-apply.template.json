        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "applications"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": "={{ $json.application }}",
          "matchingColumns": []
        },
        "options": {}
      }
    },
    {
      "id": "sheet-update-job",
      "name": "Update Job Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        3980,
        120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Load Profile').first().json.config.sheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "jobs"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": "={{ $('Record Outcome').item.json.job_update }}",
          "matchingColumns": [
            "job_id"
          ]
        },
        "options": {}
      },
      "notes": "Matches on job_id. This is the state transition that makes the whole pipeline resumable."
    },
    {
      "id": "if-notify",
      "name": "IF Notify Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        4200,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "notifyon",
              "leftValue": "={{ $('Load Profile').first().json.config.notify }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "notes": "TELEGRAM_ENABLED in .env. Off by default — everything still works, you just read the spreadsheet instead of getting messages."
    },
    {
      "id": "if-notify-summary",
      "name": "IF Notify Summary",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        -160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "notifyon2",
              "leftValue": "={{ $('Load Profile').first().json.config.notify }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "telegram-each",
      "name": "Telegram Notify",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        4420,
        120
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "chatId": "={{ $('Load Profile').first().json.config.telegram_chat_id }}",
        "text": "={{ ({success:'✅',submitted_unconfirmed:'⚠️',dry_run:'🧪',manual:'✋',failed:'❌'})[$('Record Outcome').item.json.result] || '❔' }} *{{ $('Record Outcome').item.json.title }}*\n{{ $('Record Outcome').item.json.company }} · {{ $('Record Outcome').item.json.ats }} · score {{ $('Record Outcome').item.json.score }}\n\nResult: `{{ $('Record Outcome').item.json.result }}` → status `{{ $('Record Outcome').item.json.status }}`\n{{ $('Record Outcome').item.json.error ? 'Error: ' + $('Record Outcome').item.json.error : '' }}\n\n{{ $('Record Outcome').item.json.url }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      }
    },
    {
      "id": "telegram-summary",
      "name": "Telegram Daily Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1340,
        -160
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "chatId": "={{ $('Load Profile').first().json.config.telegram_chat_id }}",
        "text": "=*Apply run finished*\n{{ $('Select Queued Jobs').all().length }} job(s) processed.\n\nCheck the `applications` tab for screenshots.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "sticky-dryrun",
      "name": "Dry run note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        3300,
        320
      ],
      "parameters": {
        "width": 440,
        "height": 220,
        "content": "### Before you turn off DRY_RUN\n\napply-svc returns `dry_run` and leaves the job `queued`, so nothing is lost while you evaluate.\n\nPhase 5 of the build order: Greenhouse only, cap 3/day, read every screenshot. Widen only after ~20 clean runs on one ATS.\n\nLinkedIn stays on `manual` unless you set LINKEDIN_AUTOSUBMIT=true. Read the header comment in `ats/linkedin.js` first — account restrictions are real and the account is where recruiters reach you."
      }
    }
