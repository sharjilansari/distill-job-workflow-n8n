{
  "name": "job-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Job APIs and page monitors feed n8n, which scores and tailors; Playwright applies. Configured entirely from .env.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "sources": "node scripts/test-sources.mjs",
    "start": "docker compose up -d && node scripts/doctor.mjs",
    "stop": "docker compose down",
    "restart": "docker compose restart",
    "logs": "docker compose logs -f",
    "login": "npm --prefix apply-svc run login --"
  }
}
