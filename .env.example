# =============================================================================
#  Job Agent — the only file you need to edit
# =============================================================================
#
#  1. Copy this file to ".env"  (npm run setup does it for you)
#  2. Fill in the lines marked REQUIRED
#  3. Run:  npm run setup
#
#  Lines starting with # are notes and are ignored.
#  Do not put quotes around values unless they contain spaces.
# =============================================================================


# -----------------------------------------------------------------------------
#  WHICH AI TO USE                                                    REQUIRED
# -----------------------------------------------------------------------------
#  Pick one:  anthropic  |  openai  |  gemini
#  You only need a key for the one you pick. Switching later means changing
#  this line and running:  docker compose restart
LLM_PROVIDER=anthropic


# --- If you chose "anthropic" (Claude) ---------------------------------------
#  Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

#  Leave these alone unless you know you want something else.
ANTHROPIC_MODEL=claude-opus-5
#  Job extraction is the high-volume step. Point it at a cheaper model here if
#  you want to save money; scoring and resume writing keep the model above.
ANTHROPIC_MODEL_EXTRACT=claude-opus-5
#  Rescues a refused request by retrying on a backup model automatically.
#  Set to false if your account does not have that feature enabled.
ANTHROPIC_ENABLE_FALLBACKS=true


# --- If you chose "openai" (ChatGPT) -----------------------------------------
#  Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

#  Set this to a model your account actually has access to. The default below
#  is a safe common choice, but model names change — check your account's list
#  if you get a "model not found" error from "npm run doctor".
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_EXTRACT=gpt-4o-mini
#  Only for reasoning models that accept it. Leave blank otherwise.
OPENAI_REASONING_EFFORT=
#  Only change for Azure OpenAI or a compatible proxy.
OPENAI_BASE_URL=https://api.openai.com/v1


# --- If you chose "gemini" (Google) ------------------------------------------
#  Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

#  As above — check your account's model list if doctor reports a bad model.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_EXTRACT=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# -----------------------------------------------------------------------------
#  YOUR SPREADSHEET                                                   REQUIRED
# -----------------------------------------------------------------------------
#  Create a Google Sheet, then run sheets/bootstrap.gs inside it once
#  (instructions in SETUP.md, step 3).
#
#  The ID is the long code in the sheet's web address:
#    docs.google.com/spreadsheets/d/  THIS_PART_HERE  /edit
GOOGLE_SHEET_ID=


# -----------------------------------------------------------------------------
#  WHERE JOBS COME FROM                                               optional
# -----------------------------------------------------------------------------
#  The searches themselves live in profile/profile.json under "sources" — this
#  section is only for the two sources that need a key, plus one safety valve.
#
#  Everything else (Instahyre, foundit.in, Greenhouse, Lever, Ashby, RemoteOK,
#  Arbeitnow) is keyless. Leave the two below blank and those still work.
#
#  Check what your sources actually return, any time:  npm run sources

#  Free tier is about 1,000 calls a month, and it covers India.
#  Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

#  Free key, 60+ countries including India.
#  Register at: https://jooble.org/api/about
JOOBLE_API_KEY=

#  A safety valve, not a quota. Every source request is a fetch against
#  someone else's server, and "four queries x twelve cities" is easy to type by
#  accident. The run stops with a clear message rather than making 48 calls.
MAX_SOURCE_REQUESTS=40


# -----------------------------------------------------------------------------
#  INTERNAL PASSWORD                                                  REQUIRED
# -----------------------------------------------------------------------------
#  A shared secret so only your own workflow can drive the browser service.
#  Any long random string. Mash the keyboard if you like — nobody types this.
APPLY_TOKEN=


# -----------------------------------------------------------------------------
#  APPLYING FOR REAL                                                  optional
# -----------------------------------------------------------------------------
#  true  = fill every field, take a screenshot, then STOP without submitting
#  false = actually submit applications
#
#  Leave this true until you have looked at a dozen screenshots and are happy
#  with what would have been sent. Nothing is lost meanwhile — jobs stay in the
#  queue and get applied to once you flip it.
DRY_RUN=true

#  Most applications to send in one run.
MAX_APPLICATIONS_PER_RUN=8

#  Pause between real submissions, in milliseconds (45s to 120s).
#  Steady traffic is treated far more kindly than bursts.
MIN_DELAY_MS=45000
MAX_DELAY_MS=120000

#  How many times a failed application is retried on later days.
MAX_ATTEMPTS=3

#  Jobs nobody acted on are marked expired after this many days.
EXPIRE_AFTER_DAYS=21


# -----------------------------------------------------------------------------
#  HOW PICKY TO BE                                                    optional
# -----------------------------------------------------------------------------
#  Every job gets a score out of 100.
#    at or above AUTO_APPLY_THRESHOLD  ->  applied to automatically
#    at or above REVIEW_THRESHOLD      ->  sent to you to decide
#    below that                        ->  dropped
#
#  Getting too many mediocre matches? Make the scoring stricter rather than
#  raising this number — see docs/runbook.md.
AUTO_APPLY_THRESHOLD=85
REVIEW_THRESHOLD=70


# -----------------------------------------------------------------------------
#  PHONE NOTIFICATIONS                                                optional
# -----------------------------------------------------------------------------
#  Leave TELEGRAM_ENABLED=false and skip this whole section if you do not want
#  messages. Everything still works; you just read the spreadsheet instead.
#
#  To set up: message @BotFather on Telegram, send /newbot, and paste the token
#  it gives you below. Then message @userinfobot to get your chat id.
TELEGRAM_ENABLED=false
TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------------
#  LINKEDIN                                                           optional
# -----------------------------------------------------------------------------
#  Leave this false unless you have read apply-svc/src/ats/linkedin.js.
#  Automated applying breaks LinkedIn's terms, accounts do get restricted, and
#  it is the account recruiters use to contact you. With this off, LinkedIn
#  jobs are handed to you with the resume already written — about forty
#  seconds of tapping, and no risk.
LINKEDIN_AUTOSUBMIT=false


# -----------------------------------------------------------------------------
#  HOUSEKEEPING                                                       optional
# -----------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

#  Where things live. Only change these if you are not using docker compose.
APPLY_SVC_URL=http://apply-svc:3000
N8N_URL=http://localhost:5678
